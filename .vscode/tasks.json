{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SubScreen：试用单指触控",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "chcp 65001 >nul && .local\\start-subscreen.cmd --touch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
